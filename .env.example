# Required for both runtime and CI.
PORT=5000
DB_NAME=ecommerce
MONGO_URI=mongodb://localhost:27017/ecommerce
JWT_SECRET=replace-me
Stripe_Secret=sk_test_replace_me
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me

# Optional: spin up an in-process Mongo for local dev without Docker.
USE_MEMORY_MONGO=

# Required for CI/CD deploy job only.
API_IMAGE=ghcr.io/<owner>/e_commerce_server-api:latest
CLIENT_IMAGE=ghcr.io/<owner>/e_commerce_server-client:latest
